{
	"name": "zed-knip",
	"private": true,
	"license": "MIT",
	"type": "module",
	"scripts": {
		"biome": "biome",
		"commitlint": "commitlint",
		"build:oxc": "bun run ./scripts/build-small-rules.ts",
		"format": "bash -c 'a=$(bash scripts/get-paths.sh \"$@\"); aube run oxfmt $a && aube run biome check --write $a' _",
		"lint": "bash -c 'a=$(bash scripts/get-paths.sh \"$@\"); aube run oxlint $a && aube run biome check $a' _",
		"oxfmt": "oxfmt",
		"oxlint": "oxlint",
		"prepare": "lefthook install",
		"skills": "skills",
		"type-check": "tsgo --noEmit"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.15",
		"@cliffy/command": "jsr:^1.1.0",
		"@commitlint/config-conventional": "^21.0.1",
		"@commitlint/types": "^21.0.1",
		"@oxlint/plugins": "^1.66.0",
		"@total-typescript/ts-reset": "^0.6.1",
		"@types/bun": "^1.3.14",
		"@types/node": "^25.9.1",
		"@typescript/native-preview": "latest",
		"arktype": "^2.2.0",
		"chrome-devtools-mcp": "^1.0.1",
		"commitlint": "^21.0.1",
		"consola": "^3.4.2",
		"eslint-plugin-antfu": "^3.2.3",
		"eslint-plugin-regexp": "^3.1.0",
		"eslint-plugin-sonarjs": "^4.0.3",
		"eslint-plugin-unused-imports": "^4.4.1",
		"oxc-parser": "^0.141.0",
		"oxc-resolver": "^11.19.1",
		"oxfmt": "^0.60.0",
		"oxlint": "^1.66.0",
		"oxlint-plugin-utilities": "^1.0.0",
		"oxlint-tsgolint": "^0.23.0",
		"package-registry-mcp": "^2.1.0",
		"pretty-bytes": "^7.1.0",
		"pretty-ms": "^9.3.0",
		"skills": "^1.5.7",
		"tsdown": "^0.22.0",
		"type-fest": "^5.6.0",
		"yoctocolors": "^2.1.2",
		"zx": "^8.8.5"
	},
	"packageManager": "aube@1.15.0"
}
