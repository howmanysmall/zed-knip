{
	"colors": true,
	"commit-msg": {
		"jobs": [
			{
				"name": "commitlint",
				"run": "env -u ABBR_TIPS_PROMPT aube run commitlint -- --edit {1}",
				"skip": ["merge", "rebase"],
			},
		],
	},
	"min_version": "2.1.6",
	"post-merge": {
		"jobs": [
			{
				"name": "package-install",
				"run": "mise x -- pullhook --install",
			},
		],
	},
	"pre-commit": {
		"jobs": [
			{
				"group": {
					"jobs": [
						{
							"glob": ["**/*.json", "**/*.jsonc"],
							"name": "biome-fix",
							"run": "mise x -- aube run biome check --write --no-errors-on-unmatched {staged_files}",
							"stage_fixed": true,
						},
						{
							"glob": [
								"**/*.js",
								"**/*.jsx",
								"**/*.ts",
								"**/*.tsx",
								"**/*.mjs",
								"**/*.mts",
								"**/*.cjs",
								"**/*.cts",
								"**/*.css",
								"**/*.html",
								"**/*.graphql",
								"**/*.gql",
								"**/*.yaml",
								"**/*.yml",
							],
							"name": "oxfmt",
							"run": "mise x -- aube run oxfmt --no-error-on-unmatched-pattern {staged_files}",
							"stage_fixed": true,
						},
						{
							"glob": "**/*.md",
							"name": "rumdl-fix",
							"run": "mise x -- rumdl fmt {staged_files}\nmise x -- rumdl check {staged_files}\n",
							"stage_fixed": true,
						},
						{
							"glob": "**/*.toml",
							"name": "tombi-fix",
							"run": "mise x -- tombi format {staged_files}\nmise x -- tombi lint {staged_files}\n",
							"stage_fixed": true,
						},
						{
							"glob": "**/*.rs",
							"name": "rustfmt",
							"run": "mise x -- cargo fmt -- {staged_files}",
							"stage_fixed": true,
						},
					],
					"parallel": true,
				},
			},
			{
				"group": {
					"jobs": [
						{
							"glob": ["**/*.json", "**/*.jsonc"],
							"name": "oxfmt-json",
							"run": "mise x -- aube run oxfmt --no-error-on-unmatched-pattern {staged_files}",
							"stage_fixed": true,
						},
					],
				},
			},
			{
				"group": {
					"jobs": [
						{
							"glob": [
								"**/*.rs",
								"**/Cargo.toml",
								"**/Cargo.lock",
								"**/deny.toml",
								"**/.cargo/config.toml",
							],
							"name": "audit",
							"run": "mise x -- cargo audit --quiet",
						},
						{
							"glob": [
								"**/*.rs",
								"**/Cargo.toml",
								"**/Cargo.lock",
								"**/deny.toml",
								"**/.cargo/config.toml",
							],
							"name": "clippy",
							"run": "mise x -- cargo clippy --all-targets -- -D warnings",
						},
						{
							"glob": [
								"**/*.rs",
								"**/Cargo.toml",
								"**/Cargo.lock",
								"**/deny.toml",
								"**/.cargo/config.toml",
							],
							"name": "deny",
							"run": "mise x -- cargo deny check",
						},
						{
							"glob": [
								"**/*.rs",
								"**/Cargo.toml",
								"**/Cargo.lock",
								"**/deny.toml",
								"**/.cargo/config.toml",
							],
							"name": "shear",
							"run": "mise x -- cargo shear",
						},
						{
							"name": "gitleaks",
							"run": "mise x -- gitleaks protect --staged",
						},
					],
					"parallel": true,
				},
			},
		],
	},
	"pre-push": {
		"jobs": [
			{
				"name": "test",
				"run": "mise x -- cargo nextest run --no-tests=pass",
			},
		],
	},
}
