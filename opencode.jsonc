{
	"$schema": "https://opencode.ai/config.json",
	"agent": {
		"ask": {
			"model": "openai/gpt-5.4",
			"temperature": 0,
		},
		"build": {
			"description": "Used after creating a plan or just whenever.",
			"mode": "all",
			"model": "openai/gpt-5.4",
			"permission": {
				"bash": {
					"*": "ask",
					"bat *": "allow",
					"cat *": "allow",
					"cd *": "allow",
					"delta *": "allow",
					"diff *": "allow",
					"du *": "allow",
					"dust *": "allow",
					"exa *": "allow",
					"fd *": "allow",
					"find *": "allow",
					"git diff*": "allow",
					"git status*": "allow",
					"grep *": "allow",
					"ls *": "allow",
					"lsd *": "allow",
					"peekaboo *": "allow",
					"rg *": "allow",
					"sd *": "allow",
					"sed *": "allow",
				},
				"codesearch": "allow",
				"doom_loop": "ask",
				"edit": "allow",
				"external_directory": "ask",
				"glob": "allow",
				"grep": "allow",
				"list": "allow",
				"lsp": "allow",
				"question": "allow",
				"read": "allow",
				"skill": "allow",
				"task": "allow",
				"todoread": "allow",
				"todowrite": "allow",
				"webfetch": "allow",
				"websearch": "allow",
			},
		},
		"plan": {
			"description": "Used to generate a plan.",
			"mode": "all",
			"model": "openai/gpt-5.4",
			"permission": {
				"bash": {
					"*": "ask",
					"bat *": "allow",
					"cat *": "allow",
					"cd *": "allow",
					"delta *": "allow",
					"diff *": "allow",
					"du *": "allow",
					"dust *": "allow",
					"exa *": "allow",
					"fd *": "allow",
					"find *": "allow",
					"git diff*": "allow",
					"git status*": "allow",
					"grep *": "allow",
					"ls *": "allow",
					"lsd *": "allow",
					"rg *": "allow",
					"sd *": "allow",
					"sed *": "allow",
				},
				"codesearch": "allow",
				"doom_loop": "ask",
				"edit": "deny",
				"external_directory": "ask",
				"glob": "allow",
				"grep": "allow",
				"list": "allow",
				"lsp": "allow",
				"question": "allow",
				"read": "allow",
				"task": "allow",
				"todoread": "allow",
				"todowrite": "allow",
				"webfetch": "ask",
				"websearch": "allow",
			},
		},
	},
	"command": {
		"goal": {
			"agent": "build",
			"description": "Set a session-scoped goal and auto-continue until complete.",
			"template": "$ARGUMENTS",
		},
	},
	"experimental": {
		"batch_tool": true,
	},
	"formatter": {
		"biome": {
			"command": ["mise", "x", "--", "aube", "run", "biome", "check", "--write", "$FILE"],
			"disabled": false,
			"extensions": [
				".astro",
				".cjs",
				".css",
				".cts",
				".gql",
				".graphql",
				".html",
				".js",
				".json",
				".jsonc",
				".jsx",
				".mjs",
				".mts",
				".scss",
				".svelte",
				".ts",
				".tsx",
				".vue",
				".yaml",
				".yml",
			],
		},
		"oxfmt": {
			"command": ["mise", "x", "--", "aube", "run", "oxfmt", "$FILE"],
			"disabled": false,
			"environment": {},
			"extensions": [
				".cjs",
				".css",
				".cts",
				".gql",
				".graphql",
				".handlebars",
				".hbs",
				".htm",
				".html",
				".js",
				".json",
				".json5",
				".jsonc",
				".jsx",
				".less",
				".mdx",
				".mjs",
				".mts",
				".sass",
				".scss",
				".ts",
				".tsx",
				".vue",
				".yaml",
				".yml",
			],
		},
		"rumdl": {
			"command": ["mise", "x", "--", "rumdl", "check", "--fix", "$FILE"],
			"disabled": false,
			"extensions": [
				".md",
				".markdown",
				".mdown",
				".mkdn",
				".mkd",
				".mdwn",
				".mdtxt",
				".mdtext",
				".text",
				".Rmd",
			],
		},
		"tombi": {
			"command": ["mise", "x", "--", "tombi", "format", "$FILE"],
			"disabled": false,
			"extensions": [".toml"],
		},
	},
	"instructions": ["./AGENTS.md"],
	"lsp": {
		"biome": {
			"command": ["mise", "x", "--", "aube", "run", "biome", "lsp-proxy"],
			"disabled": false,
			"env": {},
			"extensions": [
				".astro",
				".cjs",
				".css",
				".cts",
				".gql",
				".graphql",
				".html",
				".js",
				".json",
				".jsonc",
				".jsx",
				".mjs",
				".mts",
				".scss",
				".svelte",
				".ts",
				".tsx",
				".vue",
				".yaml",
				".yml",
			],
		},
		"oxfmt": {
			"command": ["mise", "x", "--", "aube", "run", "oxfmt", "--lsp"],
			"disabled": false,
			"extensions": [
				".cjs",
				".css",
				".cts",
				".gql",
				".graphql",
				".handlebars",
				".hbs",
				".htm",
				".html",
				".js",
				".json",
				".json5",
				".jsonc",
				".jsx",
				".less",
				".mdx",
				".mjs",
				".mts",
				".sass",
				".scss",
				".ts",
				".tsx",
				".vue",
				".yaml",
				".yml",
			],
			"initialization": {},
		},
		"oxlint": {
			"command": ["mise", "x", "--", "aube", "run", "oxlint", "--lsp"],
			"disabled": false,
			"extensions": [".js", ".mjs", ".cjs", ".ts", ".mts", ".cts", ".jsx", ".tsx", ".vue", ".svelte", ".astro"],
			"initialization": {},
		},
		"rumdl": {
			"command": ["mise", "x", "--", "rumdl", "server"],
			"disabled": false,
			"extensions": [
				".md",
				".markdown",
				".mdown",
				".mkdn",
				".mkd",
				".mdwn",
				".mdtxt",
				".mdtext",
				".text",
				".Rmd",
			],
		},
		"rust-analyzer": {
			"command": ["mise", "x", "--", "rust-analyzer"],
			"disabled": false,
			"extensions": [".rs"],
		},
		"tombi": {
			"command": ["mise", "x", "--", "tombi", "lsp"],
			"disabled": false,
			"extensions": [".toml"],
		},
	},
	"mcp": {
		"astro-docs": {
			"enabled": false,
			"type": "remote",
			"url": "https://mcp.docs.astro.build/mcp",
		},
		"chrome-dev-tools": {
			"command": ["bash", "./scripts/get-chrome-path.sh", "--serve"],
			"enabled": false,
			"type": "local",
		},
		"context7": {
			"enabled": true,
			"headers": { "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}" },
			"type": "remote",
			"url": "https://mcp.context7.com/mcp",
		},
		"gh-grep": {
			"enabled": true,
			"type": "remote",
			"url": "https://mcp.grep.app",
		},
		"github": {
			"enabled": false,
			"headers": { "Authorization": "Bearer {env:GITHUB_PAT}" },
			"type": "remote",
			"url": "https://api.githubcopilot.com/mcp/",
		},
		"package-registry": {
			"command": ["package-registry-mcp"],
			"enabled": false,
			"type": "local",
		},
	},
	"permission": {
		"bash": {
			"*": "ask",
			"bat *": "allow",
			"cargo build *": "allow",
			"cargo check *": "allow",
			"cargo clippy *": "allow",
			"cargo doc *": "allow",
			"cargo run *": "allow",
			"cargo test *": "allow",
			"cat *": "allow",
			"cd *": "allow",
			"delta *": "allow",
			"diff *": "allow",
			"du *": "allow",
			"dust *": "allow",
			"exa *": "allow",
			"fd *": "allow",
			"find *": "allow",
			"grep *": "allow",
			"ls *": "allow",
			"lsd *": "allow",
			"rg *": "allow",
			"sd *": "allow",
			"sed *": "allow",
		},
		"doom_loop": "ask",
		"edit": "ask",
		"external_directory": "ask",
		"skill": "ask",
		"webfetch": "ask",
	},
	"plugin": ["opencode-wakatime", "@mohak34/opencode-notifier@latest", "opencode-goal-plugin"],
	"provider": {
		"openai": {
			"models": {
				"gpt-5.4": {
					"limit": { "context": 200000, "output": 128000 },
				},
				"gpt-5.5": {
					"limit": { "context": 200000, "output": 128000 },
				},
			},
		},
	},
	"shell": "fish",
}
